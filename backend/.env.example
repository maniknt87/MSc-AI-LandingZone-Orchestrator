# Azure DevOps REST API connection used by the FastAPI backend
AZDO_ORGANIZATION=your-organization
AZDO_PROJECT=your-project
AZDO_AZURE_PIPELINE_ID=12
AZDO_AWS_PIPELINE_ID=13
AZDO_PAT=store-this-in-a-secret-store
AZDO_BRANCH=refs/heads/main

# Azure ML playground endpoint
AZURE_ML_ENDPOINT_NAME=sentiment-ai-4bb8b779
AZURE_ML_DEPLOYMENT_NAME=sentiment-v1
AZURE_ML_MODEL_VERSION=1
AZURE_ML_SCORING_URI=
AZURE_ML_ENDPOINT_KEY=store-this-in-a-secret-store
AZURE_ML_REQUEST_TIMEOUT=60

# AWS SageMaker uses the standard boto3 credential chain. Prefer an IAM role
# when hosted; AWS_PROFILE is convenient for local development.
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_SAGEMAKER_ENDPOINT_NAME=sentiment-customer-ai-platform-development
AWS_SAGEMAKER_MODEL_VERSION=distilbert-sst2
AWS_SAGEMAKER_REQUEST_TIMEOUT=70

# Frontend origins can be expanded in backend/app.py for deployed environments.
